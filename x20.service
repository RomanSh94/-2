# X20 systemd unit — текущий прод-деплой (/root/-2, под root).
#
# ВНИМАНИЕ: User=root и /root/-2 — это унаследованный деплой (вариант B в
# DEPLOY.md). Технический долг: при переезде на новый сервер ставить по
# варианту A (/opt/x20 + отдельный пользователь x20 без root).
#
# Установка:
#   cp x20.service /etc/systemd/system/x20.service
#   systemctl daemon-reload
#   systemctl enable --now x20

[Unit]
Description=X20 Telegram support bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/-2
EnvironmentFile=/root/-2/.env
# stdout is a pipe under systemd, so CPython fully block-buffers it by
# default -- privacy-safe dispatch diagnostics (_dispatch_log in bot.py)
# can then sit unflushed in-process for an unbounded time before appearing
# in `journalctl -u x20`, even though the process is healthy and handling
# real traffic. This does not change bot behavior, only when its existing
# print() output reaches the journal.
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/-2/venv/bin/python bot.py
# always, не on-failure: aiogram при SIGTERM выходит с кодом 0,
# и on-failure такой выход не перезапустил бы.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
